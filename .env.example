# Copy to .env and fill in. Never commit .env.

# LLM provider. Leave unset to run in replay/fake mode (no API calls).
ANTHROPIC_API_KEY=

# Default model and per-route overrides (configurable so evals can pick).
MEDCHRON_MODEL=claude-opus-5-5

# Hard cap on LLM spend per case, in US dollars (the pipeline stops cleanly when exceeded).
MEDCHRON_CASE_BUDGET_USD=2.00

# Database (docker-compose default)
DATABASE_URL=postgresql+psycopg://medchron:medchron@localhost:5432/medchron
